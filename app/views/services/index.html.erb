<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Services &amp; prices</h1>
  <%= link_to "New service", new_service_path, class: "btn btn-primary" %>
</div>
<p>Our current wall list of services and prices.</p>
<% if @services.any? %>
  <table class="table table-striped">
    <thead><tr><th>Service</th><th>Price</th></tr></thead>
    <tbody><%= render @services %></tbody>
  </table>
<% else %>
  <p class="text-muted">No services yet.</p>
<% end %>
