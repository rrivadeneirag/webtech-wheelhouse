<% content_for :title, "Create your account" %>
<div class="row justify-content-center">
  <div class="col-md-5">
    <h1 class="h3 mb-3">Create your account</h1>
    <%= form_with model: @user, url: registration_path do |form| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger" role="alert">
          <p class="mb-1 fw-semibold"><%= pluralize(@user.errors.count, "error") %> stopped this from saving:</p>
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
          </ul>
        </div>
      <% end %>
      <div class="mb-3">
        <%= form.label :email_address, "Email address", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              class: "form-control #{'is-invalid' if @user.errors[:email_address].any?}" %>
      </div>
      <div class="mb-3">
        <%= form.label :password, "Password", class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
              class: "form-control #{'is-invalid' if @user.errors[:password].any?}" %>
        <div class="form-text">At least 10 characters.</div>
      </div>
      <div class="mb-3">
        <%= form.label :password_confirmation, "Repeat password", class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
              class: "form-control #{'is-invalid' if @user.errors[:password_confirmation].any?}" %>
      </div>
      <%= form.submit "Create account", class: "btn btn-primary" %>
    <% end %>
    <hr>
    <p class="mb-0">Already have an account? <%= link_to "Sign in", new_session_path %>.</p>
  </div>
</div>
