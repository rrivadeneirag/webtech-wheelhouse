<% content_for :title, @bike.make_model %>
<p><%= link_to "← All bikes", bikes_path %></p>
<div class="d-flex justify-content-between align-items-start mb-3">
  <h1 class="mb-0"><%= @bike.make_model %></h1>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_bike_path(@bike), class: "btn btn-outline-primary" %>
    <%= button_to "Delete", @bike, method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete #{@bike.make_model}? This also removes its repairs." } } %>
  </div>
</div>
<dl class="row">
  <dt class="col-sm-3">Serial number</dt><dd class="col-sm-9"><%= @bike.serial_number %></dd>
  <dt class="col-sm-3">Colour</dt><dd class="col-sm-9"><%= @bike.colour.presence || "—" %></dd>
  <dt class="col-sm-3">Owner</dt><dd class="col-sm-9"><%= link_to @bike.customer.name, @bike.customer %></dd>
</dl>

<h2 class="h4">Repairs</h2>
<% if @repairs.any? %>
  <table class="table table-striped align-middle">
    <thead><tr><th>Photo</th><th>Repair</th><th>Bike</th><th>Customer</th><th>Status</th><th>Promised</th><th>Diagnosis</th></tr></thead>
    <tbody><%= render @repairs %></tbody>
  </table>
<% else %>
  <p class="text-muted">This bike has never been in for a repair.</p>
<% end %>
