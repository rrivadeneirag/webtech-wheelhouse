<%= form_with model: staff, class: "mb-4" do |form| %>
  <%= render "shared/errors", object: staff %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control #{invalid_class(staff, :name)}" %>
    <%= field_feedback(staff, :name) %>
  </div>

  <div class="mb-3">
    <%= form.label :role, class: "form-label" %>
    <%= form.text_field :role, class: "form-control #{invalid_class(staff, :role)}" %>
    <%= field_feedback(staff, :role) %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", (staff.persisted? ? staff : staffs_path), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
