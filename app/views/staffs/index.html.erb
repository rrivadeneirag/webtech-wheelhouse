<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Staff</h1>
  <%= link_to "New staff member", new_staff_path, class: "btn btn-primary" %>
</div>
<% if @staffs.any? %>
  <table class="table table-striped">
    <thead><tr><th>Name</th><th>Role</th><th>Repairs</th></tr></thead>
    <tbody><%= render @staffs %></tbody>
  </table>
<% else %>
  <p class="text-muted">No staff yet.</p>
<% end %>
