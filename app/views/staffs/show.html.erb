<% content_for :title, @staff.name %>
<p><%= link_to "← All staff", staffs_path %></p>
<div class="d-flex justify-content-between align-items-start mb-3">
  <h1 class="mb-0"><%= @staff.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_staff_path(@staff), class: "btn btn-outline-primary" %>
    <%= button_to "Delete", @staff, method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete #{@staff.name}? Their repairs stay but lose the mechanic." } } %>
  </div>
</div>
<dl class="row">
  <dt class="col-sm-3">Role</dt><dd class="col-sm-9"><%= @staff.role %></dd>
</dl>

<h2 class="h4">Repairs handled</h2>
<% if @repairs.any? %>
  <table class="table table-striped align-middle">
    <thead><tr><th>Repair</th><th>Bike</th><th>Customer</th><th>Status</th><th>Promised</th></tr></thead>
    <tbody><%= render @repairs %></tbody>
  </table>
<% else %>
  <p class="text-muted">This staff member has not handled any repairs yet.</p>
<% end %>
