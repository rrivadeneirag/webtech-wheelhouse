<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wheelhouse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Wheelhouse">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary mb-4">
      <div class="container">
        <%= link_to "Wheelhouse", (authenticated? ? root_path : services_path), class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <% if authenticated? %>
            <ul class="navbar-nav me-auto">
              <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %></li>
              <li class="nav-item"><%= link_to "Customers", customers_path, class: "nav-link #{'active' if current_page?(customers_path)}" %></li>
              <li class="nav-item"><%= link_to "Bikes", bikes_path, class: "nav-link #{'active' if current_page?(bikes_path)}" %></li>
              <li class="nav-item"><%= link_to "Repairs", repairs_path, class: "nav-link #{'active' if current_page?(repairs_path)}" %></li>
              <li class="nav-item"><%= link_to "Services", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %></li>
              <li class="nav-item"><%= link_to "Staff", staffs_path, class: "nav-link #{'active' if current_page?(staffs_path)}" %></li>
              <li class="nav-item"><%= link_to "Visiting", visiting_path, class: "nav-link #{'active' if current_page?(visiting_path)}" %></li>
              <li class="nav-item"><%= link_to "About", about_path, class: "nav-link #{'active' if current_page?(about_path)}" %></li>
            </ul>
            <ul class="navbar-nav ms-auto align-items-lg-center">
              <li class="nav-item">
                <span class="navbar-text me-lg-2">
                  <%= Current.user.display_name %> <span class="badge text-bg-secondary"><%= Current.user.role %></span>
                </span>
              </li>
              <li class="nav-item">
                <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-sm btn-outline-secondary" %>
              </li>
            </ul>
          <% else %>
            <ul class="navbar-nav me-auto">
              <li class="nav-item"><%= link_to "Services", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %></li>
            </ul>
            <ul class="navbar-nav ms-auto">
              <li class="nav-item"><%= link_to "Sign in", new_session_path, class: "nav-link" %></li>
            </ul>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container">
      <% if flash.notice.present? %>
        <div class="alert alert-success" role="alert"><%= flash.notice %></div>
      <% end %>
      <% if flash.alert.present? %>
        <div class="alert alert-danger" role="alert"><%= flash.alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
