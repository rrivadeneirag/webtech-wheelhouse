<% if object.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <p class="mb-1 fw-semibold"><%= pluralize(object.errors.count, "error") %> stopped this from being saved:</p>
    <ul class="mb-0">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
