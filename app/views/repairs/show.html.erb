<% content_for :title, "Repair ##{@repair.id}" %>
<p><%= link_to "← All repairs", repairs_path %></p>
<div class="d-flex justify-content-between align-items-start mb-3">
  <h1 class="mb-0">Repair #<%= @repair.id %></h1>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_repair_path(@repair), class: "btn btn-outline-primary" %>
    <%= button_to "Delete", @repair, method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete repair ##{@repair.id}? This cannot be undone." } } %>
  </div>
</div>
<dl class="row">
  <dt class="col-sm-3">Bike</dt><dd class="col-sm-9"><%= link_to @repair.bike.make_model, @repair.bike %></dd>
  <dt class="col-sm-3">Customer</dt><dd class="col-sm-9"><%= link_to @repair.bike.customer.name, @repair.bike.customer %></dd>
  <dt class="col-sm-3">Mechanic</dt><dd class="col-sm-9"><%= @repair.mechanic ? link_to(@repair.mechanic.name, @repair.mechanic) : "Unassigned" %></dd>
  <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><%= @repair.status.humanize %></dd>
  <dt class="col-sm-3">Received</dt><dd class="col-sm-9"><%= format_instant(@repair.received_at) %></dd>
  <dt class="col-sm-3">Promised</dt><dd class="col-sm-9"><%= format_day(@repair.promised_on) || "—" %></dd>
  <dt class="col-sm-3">Handed back</dt><dd class="col-sm-9"><%= format_instant(@repair.handed_back_at) || "—" %></dd>
</dl>

<h2 class="h4">Diagnosis</h2>
<% if @repair.diagnosis.present? %>
  <%= @repair.diagnosis %>
<% else %>
  <p class="text-muted">No diagnosis written yet.</p>
<% end %>

<h2 class="h4 mt-4">Intake photos</h2>
<% if @repair.intake_photos.attached? %>
  <div class="row g-3">
    <% @repair.intake_photos.each do |photo| %>
      <div class="col-6 col-md-3">
        <%= link_to rails_blob_path(photo, disposition: "inline"), target: "_blank", rel: "noopener" do %>
          <%= image_tag photo.variant(:card),
                alt: "Intake photo of #{@repair.bike.make_model} for repair ##{@repair.id}",
                class: "img-fluid rounded border" %>
        <% end %>
        <%= button_to "Remove", repair_photo_path(@repair, photo), method: :delete,
              class: "btn btn-sm btn-outline-danger w-100 mt-1",
              form: { data: { turbo_confirm: "Remove this photo?" } } %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No intake photos for this repair.</p>
<% end %>

<h2 class="h4 mt-4">Services charged</h2>
<% if @lines.any? %>
  <table class="table table-striped">
    <thead><tr><th>Service</th><th class="text-end">Charged</th></tr></thead>
    <tbody>
      <% @lines.each do |line| %>
        <tr>
          <td><%= link_to line.service.name, line.service %></td>
          <td class="text-end"><%= number_to_currency(line.charged_price) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th>Total</th>
        <th class="text-end"><%= number_to_currency(@repair.total) %></th>
      </tr>
    </tfoot>
  </table>
<% else %>
  <p class="text-muted">No services have been charged on this repair yet.</p>
<% end %>
