<% content_for :title, "Edit repair ##{@repair.id}" %>
<p><%= link_to "← Back to repair ##{@repair.id}", @repair %></p>
<h1>Edit repair #<%= @repair.id %></h1>

<%= render "form", repair: @repair %>

<% current_photos = @repair.intake_photos.select(&:persisted?) %>
<% if current_photos.any? %>
  <hr>
  <h2 class="h5">Current photos</h2>
  <p class="text-muted small">Removing a photo here leaves the others in place.</p>
  <div class="row g-2">
    <% current_photos.each do |photo| %>
      <div class="col-4 col-md-2">
        <%= image_tag photo.variant(:thumb),
              alt: "Intake photo of #{@repair.bike.make_model} for repair ##{@repair.id}",
              class: "img-fluid rounded border" %>
        <%= button_to "Remove", repair_photo_path(@repair, photo), method: :delete,
              class: "btn btn-sm btn-outline-danger w-100 mt-1",
              form: { data: { turbo_confirm: "Remove this photo?" } } %>
      </div>
    <% end %>
  </div>
<% end %>
