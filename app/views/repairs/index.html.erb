<h1>Repairs</h1>
<% if @repairs.any? %>
  <table class="table table-striped align-middle">
    <thead><tr><th>Repair</th><th>Bike</th><th>Customer</th><th>Status</th><th>Promised</th></tr></thead>
    <tbody><%= render @repairs %></tbody>
  </table>
<% else %>
  <p class="text-muted">No repairs yet.</p>
<% end %>
