<tr class="<%= 'table-warning' if repair.overdue? %>">
  <td><%= link_to "Repair ##{repair.id}", repair %></td>
  <td><%= link_to repair.bike.make_model, repair.bike %></td>
  <td><%= link_to repair.bike.customer.name, repair.bike.customer %></td>
  <td><span class="badge text-bg-secondary"><%= repair.status.humanize %></span></td>
  <td><%= format_day(repair.promised_on) || "—" %><% if repair.overdue? %> <span class="badge text-bg-warning">overdue</span><% end %></td>
</tr>
