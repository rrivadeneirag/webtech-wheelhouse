<% content_for :title, "Forgot your password?" %>
<div class="row justify-content-center">
  <div class="col-md-5">
    <h1 class="h3 mb-3">Forgot your password?</h1>
    <p class="text-muted">Enter your email address and we'll send you a link to reset it.</p>
    <%= form_with url: passwords_path do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, "Email address", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-control" %>
      </div>
      <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
    <% end %>
    <hr>
    <p class="mb-0"><%= link_to "Back to sign in", new_session_path %></p>
  </div>
</div>
