<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Customers</h1>
  <% if policy(Customer).new? %><%= link_to "New customer", new_customer_path, class: "btn btn-primary" %><% end %>
</div>
<% if @customers.any? %>
  <table class="table table-striped">
    <thead><tr><th>Name</th><th>Phone</th><th>Bikes</th></tr></thead>
    <tbody><%= render @customers %></tbody>
  </table>
<% else %>
  <p class="text-muted">No customers yet.</p>
<% end %>
