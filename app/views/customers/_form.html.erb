<%= form_with model: customer, class: "mb-4" do |form| %>
  <%= render "shared/errors", object: customer %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control #{invalid_class(customer, :name)}" %>
    <%= field_feedback(customer, :name) %>
  </div>

  <div class="mb-3">
    <%= form.label :phone, class: "form-label" %>
    <%= form.text_field :phone, class: "form-control #{invalid_class(customer, :phone)}" %>
    <%= field_feedback(customer, :phone) %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", (customer.persisted? ? customer : customers_path), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
