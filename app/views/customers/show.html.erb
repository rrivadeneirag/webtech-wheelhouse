<% content_for :title, @customer.name %>
<p><%= link_to "← All customers", customers_path %></p>
<h1><%= @customer.name %></h1>
<dl class="row">
  <dt class="col-sm-3">Phone</dt><dd class="col-sm-9"><%= @customer.phone %></dd>
</dl>

<h2 class="h4">Bikes</h2>
<% if @bikes.any? %>
  <table class="table table-striped">
    <thead><tr><th>Model</th><th>Serial</th><th>Colour</th><th>Owner</th></tr></thead>
    <tbody><%= render @bikes %></tbody>
  </table>
<% else %>
  <p class="text-muted">This customer has no bikes.</p>
<% end %>
